{
  "manifest_version": 3,
  "name": "子母畫面播放器 (Picture-in-Picture)",
  "version": "1.4.0",
  "description": "點一下圖示，即可把目前頁面的影片用子母畫面 (PiP) 浮窗播放。",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "子母畫面播放 (PiP)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-pip": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "Alt+P"
      },
      "description": "切換子母畫面 (PiP)"
    }
  }
}
